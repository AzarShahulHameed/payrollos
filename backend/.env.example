# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/payrollos

# ─── JWT — CHANGE THESE IN PRODUCTION (use 64+ char random strings) ──
JWT_SECRET=CHANGE_ME_use_openssl_rand_base64_64
JWT_REFRESH_SECRET=CHANGE_ME_use_openssl_rand_base64_64
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Server ──────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ─── Email (SMTP) ────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_REPLACE_WITH_YOUR_KEY
SMTP_FROM=PayrollOS <hr@yourcompany.com>

# ─── Cloudinary (file uploads) ───────────────────────────────
# API_SECRET stays SERVER-SIDE ONLY — never put in frontend .env
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret_NEVER_EXPOSE_THIS
